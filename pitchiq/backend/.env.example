# PitchIQ backend — environment variables
# Copy to backend/.env and fill in your values

# Database (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pitchiq

# Redis
REDIS_URL=redis://localhost:6379

# LLM API keys
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Jina AI embeddings
JINA_API_KEY=
EMBEDDING_MODEL=jina-embeddings-v3

# Web search
TAVILY_API_KEY=

# Optional — future auth
SECRET_KEY=changeme
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
